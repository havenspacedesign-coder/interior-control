{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --omit=dev --include=optional",
  "functions": {
    "api/ai-case-analyze.js": {
      "includeFiles": "node_modules/{pdfjs-dist/{package.json,legacy/build/pdf.worker.mjs,cmaps/**,standard_fonts/**},@napi-rs/canvas*/**}"
    }
  },
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://have000.firebaseapp.com/__/auth/:path*"
    }
  ]
}
