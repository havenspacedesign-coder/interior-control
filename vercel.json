{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/ai-case-analyze.js": {
      "installCommand": "npm ci --omit=dev",
      "includeFiles": "node_modules/pdfjs-dist/{legacy/build/pdf.worker.mjs,cmaps/**,standard_fonts/**}"
    }
  },
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://have000.firebaseapp.com/__/auth/:path*"
    }
  ]
}
